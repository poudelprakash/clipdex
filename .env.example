# Database
DATABASE_URL=postgresql+psycopg://localhost:5432/clipdex

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=@TheDoersglobal

# YouTube's bot detection blocks anonymous yt-dlp requests; pull cookies from
# your signed-in browser. Set "chrome", "safari", "firefox", "brave", or "" to disable.
YTDLP_COOKIES_FROM_BROWSER=chrome
MAX_VIDEOS_PER_RUN=0

# LLM provider routing (post 5)
LLM_PROVIDER=anthropic            # anthropic | openai | ollama | fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# API
API_HOST=127.0.0.1
API_PORT=8000

# Web (Vite proxies /api/* to API_PORT)
VITE_API_BASE=/api
